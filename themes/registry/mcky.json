{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "mcky",
  "type": "registry:theme",
  "description": "mcky.space — neobrutalism, 3px border, hard shadow, mono 100%",
  "cssVars": {
    "theme": {
      "--accent-2": "#00cec9",
      "--accent-deep": "#d9a400",
      "--accent-foreground": "hsl(0 0% 0%)",
      "--border-width": "3px",
      "--card-foreground": "hsl(0 0% 0%)",
      "--destructive-foreground": "hsl(0 0% 0%)",
      "--font-display": "'JetBrains Mono', ui-monospace, monospace",
      "--font-mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
      "--font-sans": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
      "--font-serif": "'JetBrains Mono', ui-monospace, monospace",
      "--info": "#4361ee",
      "--muted-foreground": "#333333",
      "--popover-foreground": "hsl(0 0% 0%)",
      "--primary-foreground": "hsl(0 0% 0%)",
      "--radius": "0.375rem",
      "--secondary-foreground": "hsl(0 0% 0%)",
      "--shadow": "4px 4px 0 hsl(var(--border))",
      "--shadow-lg": "4px 4px 0 hsl(var(--border))",
      "--shadow-md": "4px 4px 0 hsl(var(--border))",
      "--success": "#06d6a0",
      "--warning": "#ff9f43"
    },
    "light": {
      "--accent": "#ffe066",
      "--background": "#f5f5f0",
      "--border": "#000000",
      "--card": "#ffffff",
      "--destructive": "#ff6b6b",
      "--foreground": "#000000",
      "--input": "hsl(0 0% 0%)",
      "--muted": "#eaeae4",
      "--popover": "hsl(0 0% 100%)",
      "--primary": "#ffe066",
      "--ring": "hsl(0 0% 0%)",
      "--secondary": "hsl(60 17% 91%)"
    },
    "dark": {
      "--accent": "#ffe066",
      "--background": "#0a0a0a",
      "--border": "#888888",
      "--card": "#141414",
      "--destructive": "hsl(0 100% 71%)",
      "--foreground": "#e0e0e0",
      "--input": "hsl(0 0% 53%)",
      "--muted": "#1f1f1f",
      "--popover": "hsl(0 0% 8%)",
      "--primary": "#ffe066",
      "--ring": "hsl(50 100% 71%)",
      "--secondary": "hsl(0 0% 12%)"
    }
  },
  "meta": {
    "name": "mcky.space",
    "vibe": "neobrutalism, 3px border, hard shadow, mono 100%",
    "mode": "dual"
  }
}