{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "claude",
  "type": "registry:theme",
  "description": "CLAUDE PAPER — warm editorial, clay, Source Serif",
  "cssVars": {
    "theme": {
      "accent-deep": "#b85c3f",
      "accent-foreground": "hsl(60 25% 98%)",
      "border-width": "1px",
      "card-foreground": "hsl(60 7% 7%)",
      "destructive-foreground": "hsl(60 25% 98%)",
      "font-display": "'Source Serif 4', Georgia, serif",
      "font-mono": "ui-monospace, 'SF Mono', monospace",
      "font-sans": "'Source Serif 4', 'Source Han Serif SC', Georgia, serif",
      "font-serif": "'Source Serif 4', 'Source Han Serif SC', Georgia, serif",
      "info": "#3a5f8a",
      "muted-foreground": "#3d3d3a",
      "popover-foreground": "hsl(60 7% 7%)",
      "primary-foreground": "hsl(60 25% 98%)",
      "radius": "0.75rem",
      "secondary-foreground": "hsl(60 7% 7%)",
      "shadow": "0 1px 2px hsl(60 7% 7% / 0.05), 0 8px 24px -18px hsl(60 7% 7% / 0.18)",
      "shadow-lg": "0 4px 12px hsl(60 7% 7% / 0.1), 0 24px 48px -24px hsl(60 7% 7% / 0.25)",
      "shadow-md": "0 1px 2px hsl(60 7% 7% / 0.05), 0 8px 24px -18px hsl(60 7% 7% / 0.18)",
      "success": "#3d7a4e",
      "warning": "#a06a00"
    },
    "light": {
      "accent": "#d97757",
      "background": "#faf9f5",
      "border": "hsl(60 7% 7% / 0.12)",
      "card": "#ffffff",
      "destructive": "#b03a2e",
      "foreground": "#141413",
      "input": "hsl(60 7% 7% / 0.12)",
      "muted": "#f1efe8",
      "popover": "hsl(0 0% 100%)",
      "primary": "#d97757",
      "ring": "hsl(60 7% 7% / 0.22)",
      "secondary": "hsl(56 27% 95%)"
    },
    "dark": {
      "accent": "#e38b6b",
      "background": "#30302e",
      "border": "hsl(60 25% 98% / 0.14)",
      "card": "#383835",
      "destructive": "#e0806f",
      "foreground": "#faf9f5",
      "input": "hsl(60 25% 98% / 0.14)",
      "muted": "#242422",
      "popover": "hsl(60 3% 21%)",
      "primary": "#e38b6b",
      "ring": "hsl(60 25% 98% / 0.24)",
      "secondary": "hsl(60 4% 14%)"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "meta": {
    "name": "CLAUDE PAPER",
    "vibe": "warm editorial, clay, Source Serif",
    "mode": "dual"
  }
}