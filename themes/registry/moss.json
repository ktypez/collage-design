{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "moss",
  "type": "registry:theme",
  "description": "MOSS — organic, earth + terracotta, Fraunces",
  "cssVars": {
    "theme": {
      "--accent-deep": "#4f6d2d",
      "--accent-foreground": "hsl(43 38% 94%)",
      "--border-width": "1px",
      "--card-foreground": "hsl(38 14% 16%)",
      "--clay": "#d9a05b",
      "--destructive-foreground": "hsl(48 53% 98%)",
      "--ease-spring": "cubic-bezier(0.34, 1.4, 0.5, 1)",
      "--font-display": "'Fraunces', Georgia, serif",
      "--font-mono": "ui-monospace, 'SF Mono', monospace",
      "--font-sans": "'Fraunces', 'Source Serif 4', Georgia, serif",
      "--font-serif": "'Fraunces', 'Source Serif 4', Georgia, serif",
      "--info": "#4a6b7a",
      "--muted-foreground": "#6b645a",
      "--popover-foreground": "hsl(38 14% 16%)",
      "--primary-foreground": "hsl(43 38% 94%)",
      "--radius": "0.75rem",
      "--secondary-foreground": "hsl(38 14% 16%)",
      "--shadow": "0 2px 4px hsl(38 14% 16% / 0.06), 0 14px 40px -20px hsl(38 14% 16% / 0.25)",
      "--shadow-lg": "0 8px 16px hsl(38 14% 16% / 0.1), 0 32px 80px -32px hsl(38 14% 16% / 0.35)",
      "--shadow-md": "0 4px 8px hsl(38 14% 16% / 0.08), 0 24px 56px -24px hsl(38 14% 16% / 0.3)",
      "--success": "#5c7a3d",
      "--terracotta": "#c4714a",
      "--terracotta-foreground": "hsl(43 38% 94%)",
      "--warning": "#b0832f"
    },
    "light": {
      "--accent": "#6a8c3f",
      "--background": "#f5f1e8",
      "--border": "hsl(38 14% 16% / 0.14)",
      "--card": "#fdfbf5",
      "--destructive": "#a84d33",
      "--foreground": "#2e2a24",
      "--input": "hsl(38 14% 16% / 0.14)",
      "--muted": "#eae3d3",
      "--popover": "hsl(48 53% 98%)",
      "--primary": "#6a8c3f",
      "--ring": "hsl(38 14% 16% / 0.28)",
      "--secondary": "hsl(47 38% 90%)"
    },
    "dark": {
      "--accent": "#6a8c3f",
      "--background": "#f5f1e8",
      "--border": "hsl(38 14% 16% / 0.14)",
      "--card": "#fdfbf5",
      "--destructive": "#a84d33",
      "--foreground": "#2e2a24",
      "--input": "hsl(38 14% 16% / 0.14)",
      "--muted": "#eae3d3",
      "--popover": "hsl(48 53% 98%)",
      "--primary": "#6a8c3f",
      "--ring": "hsl(38 14% 16% / 0.28)",
      "--secondary": "hsl(47 38% 90%)"
    }
  },
  "meta": {
    "name": "MOSS",
    "vibe": "organic, earth + terracotta, Fraunces",
    "mode": "light-only"
  }
}