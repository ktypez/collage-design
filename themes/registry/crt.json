    "dark": {
      "--accent": "#4af626",
      "--background": "#060605",
      "--border": "#263a26",
      "--card": "#0d0d0b",
      "--destructive": "#ff5c5c",
      "--foreground": "#c5d9b7",
      "--input": "hsl(120 21% 19%)",
      "--muted": "#141410",
      "--popover": "hsl(60 13% 5%)",
      "--primary": "#4af626",
      "--ring": "#3d5c3d",
      "--secondary": "hsl(60 14% 7%)"
    }
  },
  "meta": {
    "name": "PIXSH v1.0",
    "vibe": "phosphor green, scanlines, VT323",
    "mode": "dark-only"
  }
