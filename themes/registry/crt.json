{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "crt",
  "type": "registry:theme",
  "description": "PIXSH v1.0 — phosphor green, scanlines, VT323",
  "cssVars": {
    "light": {
      "accent": "#4af626",
      "accent-dim": "#2e9e1e",
      "accent-foreground": "hsl(60 17% 2%)",
      "background": "#060605",
      "border": "#263a26",
      "border-width": "1px",
      "card": "#0d0d0b",
      "card-foreground": "hsl(105 32% 78%)",
      "destructive": "#ff5c5c",
      "destructive-foreground": "hsl(60 17% 2%)",
      "font-mono": "'VT323', 'JetBrains Mono', ui-monospace, monospace",
      "font-sans": "'VT323', 'Inter', sans-serif",
      "foreground": "#c5d9b7",
      "input": "hsl(120 21% 19%)",
      "muted": "#141410",
      "muted-foreground": "#7a8f74",
      "popover": "hsl(60 13% 5%)",
      "popover-foreground": "hsl(105 32% 78%)",
      "primary": "#4af626",
      "primary-foreground": "hsl(60 17% 2%)",
      "radius": "0",
      "ring": "#3d5c3d",
      "secondary": "hsl(60 14% 7%)",
      "secondary-foreground": "hsl(105 32% 78%)",
      "shadow": "none",
      "shadow-lg": "none",
      "shadow-md": "none"
    },
    "dark": {
      "accent": "#4af626",
      "accent-dim": "#2e9e1e",
      "accent-foreground": "hsl(60 17% 2%)",
      "background": "#060605",
      "border": "#263a26",
      "border-width": "1px",
      "card": "#0d0d0b",
      "card-foreground": "hsl(105 32% 78%)",
      "destructive": "#ff5c5c",
      "destructive-foreground": "hsl(60 17% 2%)",
      "font-mono": "'VT323', 'JetBrains Mono', ui-monospace, monospace",
      "font-sans": "'VT323', 'Inter', sans-serif",
      "foreground": "#c5d9b7",
      "input": "hsl(120 21% 19%)",
      "muted": "#141410",
      "muted-foreground": "#7a8f74",
      "popover": "hsl(60 13% 5%)",
      "popover-foreground": "hsl(105 32% 78%)",
      "primary": "#4af626",
      "primary-foreground": "hsl(60 17% 2%)",
      "radius": "0",
      "ring": "#3d5c3d",
      "secondary": "hsl(60 14% 7%)",
      "secondary-foreground": "hsl(105 32% 78%)",
      "shadow": "none",
      "shadow-lg": "none",
      "shadow-md": "none"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "meta": {
    "name": "PIXSH v1.0",
    "vibe": "phosphor green, scanlines, VT323",
    "mode": "dark-only"
  }
}