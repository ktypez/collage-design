{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "crt",
  "type": "registry:theme",
  "description": "PIXSH v1.0 — phosphor green, scanlines, VT323",
  "cssVars": {
    "theme": {
      "--accent-dim": "#2e9e1e",
      "--accent-foreground": "hsl(60 17% 2%)",
      "--border-width": "1px",
      "--card-foreground": "hsl(105 32% 78%)",
      "--destructive-foreground": "hsl(60 17% 2%)",
      "--font-mono": "'VT323', 'JetBrains Mono', ui-monospace, monospace",
      "--font-sans": "'VT323', 'Inter', sans-serif",
      "--muted-foreground": "#7a8f74",
      "--popover-foreground": "hsl(105 32% 78%)",
      "--primary-foreground": "hsl(60 17% 2%)",
      "--radius": "0",
      "--secondary-foreground": "hsl(105 32% 78%)",
      "--shadow": "none",
      "--shadow-lg": "none",
      "--shadow-md": "none"
