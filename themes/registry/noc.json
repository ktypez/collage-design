{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "noc",
  "type": "registry:theme",
  "description": "PACKETGRID — NOC dashboard, cyan+green",
  "cssVars": {
    "theme": {
      "accent-2": "#00d4ff",
      "accent-foreground": "hsl(207 29% 5%)",
      "border-width": "1px",
      "card-foreground": "hsl(207 38% 90%)",
      "destructive-foreground": "hsl(207 38% 90%)",
      "font-mono": "'JetBrains Mono', ui-monospace, monospace",
      "font-sans": "'Inter', system-ui, sans-serif",
      "info": "hsl(190 100% 50%)",
      "muted-foreground": "#7d8fa1",
      "popover-foreground": "hsl(207 38% 90%)",
      "primary-foreground": "hsl(207 29% 5%)",
      "radius": "0",
      "secondary-foreground": "hsl(207 38% 90%)",
      "shadow": "none",
      "shadow-lg": "none",
      "shadow-md": "none",
      "success": "#3ddc84",
      "warning": "hsl(38 92% 50%)"
    },
    "light": {
      "accent": "#35f0c8",
      "background": "#0a0f14",
      "border": "#1c2836",
      "card": "#0f161d",
      "destructive": "#ff5c5c",
      "foreground": "#d9e6f2",
      "input": "hsl(207 27% 16%)",
      "muted": "#131c25",
      "popover": "hsl(206 28% 9%)",
      "primary": "#35f0c8",
      "ring": "#2a3b4d",
      "secondary": "hsl(207 28% 11%)"
    },
    "dark": {
      "accent": "#35f0c8",
      "background": "#0a0f14",
      "border": "#1c2836",
      "card": "#0f161d",
      "destructive": "#ff5c5c",
      "foreground": "#d9e6f2",
      "input": "hsl(207 27% 16%)",
      "muted": "#131c25",
      "popover": "hsl(206 28% 9%)",
      "primary": "#35f0c8",
      "ring": "#2a3b4d",
      "secondary": "hsl(207 28% 11%)"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "meta": {
    "name": "PACKETGRID",
    "vibe": "NOC dashboard, cyan+green",
    "mode": "dark-only"
  }
}