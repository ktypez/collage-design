{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "rack",
  "type": "registry:theme",
  "description": "STACK//FRAME — server rack, amber LED, Inter+mono",
  "cssVars": {
    "theme": {
      "accent-2": "#00ff66",
      "accent-foreground": "hsl(240 8% 4%)",
      "border-width": "1px",
      "card-foreground": "hsl(240 7% 96%)",
      "destructive-foreground": "hsl(240 7% 96%)",
      "font-mono": "'JetBrains Mono', ui-monospace, monospace",
      "font-sans": "'Inter', system-ui, sans-serif",
      "info": "#00d4ff",
      "muted-foreground": "#8a8a93",
      "popover-foreground": "hsl(240 7% 96%)",
      "primary-foreground": "hsl(240 8% 4%)",
      "radius": "0",
      "secondary-foreground": "hsl(240 7% 96%)",
      "shadow": "none",
      "shadow-lg": "none",
      "shadow-md": "none",
      "success": "hsl(145 100% 50%)",
      "warning": "hsl(40 100% 50%)"
    },
    "light": {
      "accent": "#ffb000",
      "background": "#0a0a0c",
      "border": "#2a2a32",
      "card": "#16161a",
      "destructive": "#ff3b30",
      "foreground": "#f5f5f7",
      "input": "hsl(240 8% 18%)",
      "muted": "hsl(240 9% 7%)",
      "popover": "hsl(240 9% 9%)",
      "primary": "#ffb000",
      "ring": "#3a3a42",
      "secondary": "hsl(240 9% 7%)"
    },
    "dark": {
      "accent": "#ffb000",
      "background": "#0a0a0c",
      "border": "#2a2a32",
      "card": "#16161a",
      "destructive": "#ff3b30",
      "foreground": "#f5f5f7",
      "input": "hsl(240 8% 18%)",
      "muted": "hsl(240 9% 7%)",
      "popover": "hsl(240 9% 9%)",
      "primary": "#ffb000",
      "ring": "#3a3a42",
      "secondary": "hsl(240 9% 7%)"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "meta": {
    "name": "STACK//FRAME",
    "vibe": "server rack, amber LED, Inter+mono",
    "mode": "dark-only"
  }
}