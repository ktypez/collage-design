{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "brut",
  "type": "registry:theme",
  "description": "BRUT — brutalist, red+black, Anton",
  "cssVars": {
    "light": {
      "accent": "#ff2e00",
      "accent-deep": "#c91f00",
      "accent-foreground": "hsl(0 0% 100%)",
      "background": "#e8e4da",
      "border": "#0d0d0d",
      "border-width": "2px",
      "card": "#ffffff",
      "card-foreground": "hsl(0 0% 5%)",
      "destructive": "hsl(10 100% 50%)",
      "destructive-foreground": "hsl(0 0% 100%)",
      "font-display": "'Anton', 'Impact', sans-serif",
      "font-mono": "'IBM Plex Mono', ui-monospace, monospace",
      "font-sans": "'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace",
      "foreground": "#0d0d0d",
      "input": "hsl(0 0% 5%)",
      "muted": "#efebe2",
      "muted-foreground": "#3d3d3a",
      "popover": "hsl(0 0% 100%)",
      "popover-foreground": "hsl(0 0% 5%)",
      "primary": "#ff2e00",
      "primary-foreground": "hsl(0 0% 100%)",
      "radius": "0",
      "ring": "hsl(10 100% 50%)",
      "secondary": "hsl(43 19% 81%)",
      "secondary-foreground": "hsl(0 0% 5%)",
      "shadow": "none",
      "shadow-lg": "none",
      "shadow-md": "none"
    },
    "dark": {
      "accent": "#ff2e00",
      "accent-deep": "#c91f00",
      "accent-foreground": "hsl(0 0% 100%)",
      "background": "#e8e4da",
      "border": "#0d0d0d",
      "border-width": "2px",
      "card": "#ffffff",
      "card-foreground": "hsl(0 0% 5%)",
      "destructive": "hsl(10 100% 50%)",
      "destructive-foreground": "hsl(0 0% 100%)",
      "font-display": "'Anton', 'Impact', sans-serif",
      "font-mono": "'IBM Plex Mono', ui-monospace, monospace",
      "font-sans": "'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace",
      "foreground": "#0d0d0d",
      "input": "hsl(0 0% 5%)",
      "muted": "#efebe2",
      "muted-foreground": "#3d3d3a",
      "popover": "hsl(0 0% 100%)",
      "popover-foreground": "hsl(0 0% 5%)",
      "primary": "#ff2e00",
      "primary-foreground": "hsl(0 0% 100%)",
      "radius": "0",
      "ring": "hsl(10 100% 50%)",
      "secondary": "hsl(43 19% 81%)",
      "secondary-foreground": "hsl(0 0% 5%)",
      "shadow": "none",
      "shadow-lg": "none",
      "shadow-md": "none"
    }
  },
  "css": {
    "@layer base": {
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "meta": {
    "name": "BRUT",
    "vibe": "brutalist, red+black, Anton",
    "mode": "light-only"
  }
}