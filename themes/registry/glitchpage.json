{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "glitchpage",
  "type": "registry:theme",
  "description": "GLITCHPAGE — error page, neon pink, Thai",
  "cssVars": {
    "theme": {
      "--accent-2": "#37e6ff",
      "--accent-foreground": "hsl(230 53% 10%)",
      "--border-width": "1px",
      "--card-foreground": "hsl(234 79% 95%)",
      "--destructive-foreground": "hsl(230 53% 10%)",
      "--font-display": "'Kanit', sans-serif",
      "--font-mono": "'JetBrains Mono', ui-monospace, monospace",
      "--font-sans": "'Sarabun', system-ui, sans-serif",
      "--info": "hsl(187 100% 61%)",
      "--muted-foreground": "#8f96c9",
      "--popover-foreground": "hsl(234 79% 95%)",
      "--primary-foreground": "hsl(230 53% 10%)",
      "--radius": "0",
      "--secondary-foreground": "hsl(234 79% 95%)",
      "--shadow": "none",
      "--shadow-lg": "none",
      "--shadow-md": "none"
    },
    "light": {
      "--accent": "#ff3d8f",
      "--background": "#0b0f2a",
      "--border": "#232a5e",
      "--card": "#111640",
      "--destructive": "#ff3d5e",
      "--foreground": "#e8eafc",
      "--input": "hsl(232 38% 25%)",
      "--muted": "#161c4d",
      "--popover": "hsl(233 53% 16%)",
      "--primary": "#ff3d8f",
      "--ring": "#333d80",
      "--secondary": "hsl(232 53% 20%)"
    },
    "dark": {
      "--accent": "#ff3d8f",
      "--background": "#0b0f2a",
      "--border": "#232a5e",
      "--card": "#111640",
      "--destructive": "#ff3d5e",
      "--foreground": "#e8eafc",
      "--input": "hsl(232 38% 25%)",
      "--muted": "#161c4d",
      "--popover": "hsl(233 53% 16%)",
      "--primary": "#ff3d8f",
      "--ring": "#333d80",
      "--secondary": "hsl(232 53% 20%)"
    }
  },
  "meta": {
    "name": "GLITCHPAGE",
    "vibe": "error page, neon pink, Thai",
    "mode": "dark-only"
  }
}